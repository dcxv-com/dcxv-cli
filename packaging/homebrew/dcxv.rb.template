class Dcxv < Formula
  desc "Manage DCXV servers, orders and payments from the terminal"
  homepage "https://dcxv.com/cli"
  version "__VERSION__"
  license "MIT"

  on_macos do
    on_arm do
      url "https://github.com/dcxv-com/dcxv-cli/releases/download/v__VERSION__/dcxv-macos-arm64"
      sha256 "__SHA256_MACOS_ARM64__"

      def install
        bin.install "dcxv-macos-arm64" => "dcxv"
      end
    end
    on_intel do
      url "https://github.com/dcxv-com/dcxv-cli/releases/download/v__VERSION__/dcxv-macos-x64"
      sha256 "__SHA256_MACOS_X64__"

      def install
        bin.install "dcxv-macos-x64" => "dcxv"
      end
    end
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/dcxv version")
  end
end
